{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:code-collie:code-collie",
            "tool": "session_signal",
            "input": {
              "session_id": "${session_id}",
              "plugin": "954b8da673a1",
              "event": "PreToolUse"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|mcp__plugin_code-collie_code-collie__record_context",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:code-collie:code-collie",
            "tool": "session_signal",
            "input": {
              "session_id": "${session_id}",
              "plugin": "954b8da673a1",
              "tool": "${tool_name}"
            },
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__plugin_code-collie_code-collie__get_context",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:code-collie:code-collie",
            "tool": "session_signal",
            "input": {
              "session_id": "${session_id}",
              "plugin": "954b8da673a1",
              "tool": "${tool_name}",
              "task": "${tool_input.task}"
            },
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/report-work.sh\"",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__plugin_code-collie_code-collie__record_context",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:code-collie:code-collie",
            "tool": "session_signal",
            "input": {
              "session_id": "${session_id}",
              "plugin": "954b8da673a1",
              "tool": "${tool_name}"
            },
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__plugin_code-collie_code-collie__get_context",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:code-collie:code-collie",
            "tool": "session_signal",
            "input": {
              "session_id": "${session_id}",
              "plugin": "954b8da673a1",
              "tool": "${tool_name}",
              "task": "${tool_input.task}"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:code-collie:code-collie",
            "tool": "session_signal",
            "input": {
              "session_id": "${session_id}",
              "plugin": "954b8da673a1",
              "event": "UserPromptSubmit"
            },
            "timeout": 5
          }
        ]
      }
    ]
  }
}
