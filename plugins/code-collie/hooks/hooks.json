{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:code-collie:code-collie",
            "tool": "session_signal",
            "input": {
              "session_id": "${session_id}",
              "plugin": "7500c3b362cc",
              "event": "PreToolUse"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|mcp__plugin_code-collie_code-collie__get_context|mcp__plugin_code-collie_code-collie__record_context",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:code-collie:code-collie",
            "tool": "session_signal",
            "input": {
              "session_id": "${session_id}",
              "plugin": "7500c3b362cc",
              "tool": "${tool_name}"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__plugin_code-collie_code-collie__get_context|mcp__plugin_code-collie_code-collie__record_context",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:code-collie:code-collie",
            "tool": "session_signal",
            "input": {
              "session_id": "${session_id}",
              "plugin": "7500c3b362cc",
              "tool": "${tool_name}"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:code-collie:code-collie",
            "tool": "session_signal",
            "input": {
              "session_id": "${session_id}",
              "plugin": "7500c3b362cc",
              "event": "UserPromptSubmit"
            },
            "timeout": 5
          }
        ]
      }
    ]
  }
}
